(text "ETHERNET & MOUSE — CYBOARD-COMPATIBLE INTERFACES" (at 20 15 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "25b3b660-006f-5046-a03f-303b551994dc"))
(text "W5100S parallel registers: FD20-FD23. PIC mouse read: FD10.\nW5100S module pins 23/24 are its 3.3V outputs and are left unconnected." (at 20 32 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "c33afab1-d781-5268-bd86-a50ec2fa33aa"))
(text "U8 pin numbering and geometry copied from Cyboard module footprint.\nDo not fit a SPI-only WIZ810Sio module." (at 20 157 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "6d067457-15d0-5cfe-887d-7f735edd2a12"))
(text "PIC RA0 = mouse clock; RA1 = mouse data.\nPIC RA2 carries response D0; retain buffer mapping.\nThis is not a USB-HID mouse host." (at 286 245 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "a75d7f53-4e25-5ac5-8af0-26784d506103"))
